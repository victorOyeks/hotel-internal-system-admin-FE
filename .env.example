# Copy to .env.local at the repo root; every app (apps/hotel, apps/admin, apps/landing) loads it.

# Base URL of the hospio-backend gateway (no trailing slash). Every service hangs off it:
# /identity, /tenant, /property, /reservation, /folio, /payment, ... Staging: https://api-staging.hospio360.com
NEXT_PUBLIC_API_URL=http://localhost:9200
# Cookie domain in production builds (NODE_ENV=production). Any non-empty value locally.
DOMAIN_URL=localhost

# Demo mode (default on): any email/password signs in with every role and the UI runs on sample data.
NEXT_PUBLIC_DEMO_MODE=true
# Sign-in: "false" uses identity-service with real accounts (staging seeds one per role, see
# hospio-backend docs/deployment-staging.md) while screens keep their sample data. Defaults to NEXT_PUBLIC_DEMO_MODE.
# NEXT_PUBLIC_DEMO_AUTH=false
# Domains wired to the backend while the rest stay on sample data. Staging: property,reservation,folio,payment
# NEXT_PUBLIC_LIVE_DOMAINS=property,reservation,folio,payment

# Where the other app lives, for the hand-off when someone signs in on the wrong one (staging hosts by default).
# NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
# NEXT_PUBLIC_HOTEL_APP_URL=http://localhost:3001

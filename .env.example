# Base URL of the hospio-backend gateway (no trailing slash). Every service hangs off it:
# /identity, /tenant, /reservation, /folio, /payment, ... see hospio-backend/README.md
NEXT_PUBLIC_API_URL=http://localhost:9200
# Cookie domain used in production builds
DOMAIN_URL=sandbox.hospio360.com
# Demo mode (default on): any email/password signs in with every role and the UI runs on sample data.
# Set to "false" once hospio-backend is reachable at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_DEMO_MODE=true
# Sign-in: "false" uses identity-service with real accounts (staging seeds test accounts, password Hospio123!),
# while screens keep their sample data until each service is wired. Defaults to NEXT_PUBLIC_DEMO_MODE.
# NEXT_PUBLIC_DEMO_AUTH=false
